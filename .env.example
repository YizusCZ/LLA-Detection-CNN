# Cómo obtener el token de Kaggle:
#   1. Entra a https://www.kaggle.com/settings
#   2. En la sección "API", crea un token nuevo (empieza con KGAT_...)
#
# El notebook lee la variable KAGGLE_API_TOKEN. En Google Colab es más cómodo guardarla
# como secreto (icono de la llave, panel izquierdo) con ese mismo nombre y dar acceso
# al notebook; el notebook no lee el archivo .env por sí solo.

KAGGLE_API_TOKEN=KGAT_pega_aqui_tu_token

# KAGGLE_USERNAME=tu_usuario_de_kaggle
# KAGGLE_KEY=tu_api_key_de_kaggle
